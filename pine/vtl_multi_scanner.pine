//@version=6
// VTL multi-symbol scanner - ONE alert for the whole watchlist.
//
// GENERATED by gen_scanner.py - do not hand-edit; re-run the generator.
//
// Why it exists: TradingView alerts are per-symbol and the VTL strategy only
// sees the chart it is attached to. Covering a 24-symbol watchlist that way
// means 24 alerts, 24 dialogs and 24 slots against the account alert limit.
// This watches them all from one chart, so ONE alert covers the lot.
//
// It is an indicator, so there is no strategy.* position state - the book is
// tracked explicitly in arrays below. That makes the P&L a clean mark against
// the tracked entry. It mirrors the strategy's logic; it is not its backtest.
//
// Symbols marked "-" in the TRADE column cannot be reached through Alpaca
// (indices, CFDs, FX). Their signals are still computed, because they are real,
// but a signal you cannot act on must never look like one you can.
//
// P&L is reported three ways - percent, USD and EUR - matching
// vtl_session_strategy.pine. EUR degrades to "n/a", never to zero.
indicator("VTL multi-symbol scanner", overlay = false, max_bars_back = 300)

fastLen  = input.int(20,  "Fast SMA", minval = 2)
slowLen  = input.int(50,  "Slow SMA", minval = 3)
rsiLen   = input.int(14,  "RSI length", minval = 2)
rsiMax   = input.float(70, "RSI overbought")
atrLen   = input.int(14,  "ATR length", minval = 2)
stopMult = input.float(2.0, "Stop x ATR")
riskPct  = input.float(0.01, "Risk per trade", step = 0.005)
acctEq   = input.float(100000, "Equity per symbol")
showAll  = input.bool(true, "Show untradable symbols too")

// USD -> EUR, resolved once at global scope and reused everywhere below.
eurusd = request.security("FX_IDC:EURUSD", "D", close, ignore_invalid_symbol = true)
usdEur = na(eurusd) or eurusd <= 0 ? na : 1.0 / eurusd

fmtSigned(v, pre) =>
    (v >= 0 ? "+" : "-") + pre + str.tostring(math.abs(v), "#,###.##")

money(usd, pct) =>
    base = fmtSigned(pct, "") + "% | " + fmtSigned(usd, "$")
    na(usdEur) ? base + " | EUR n/a" : base + " | " + fmtSigned(usd * usdEur, "EUR ")

// Evaluated in each symbol's own context so nothing repaints across symbols.
probe() =>
    f = ta.sma(close, fastLen)
    s = ta.sma(close, slowLen)
    r = ta.rsi(close, rsiLen)
    a = ta.atr(atrLen)
    [close, f, s, r, a, ta.crossover(f, s), ta.crossunder(f, s)]

// -- one request.security per symbol; Pine cannot loop these --
[c0, f0, s0, r0, a0, xo0, xu0] = request.security("NASDAQ:AAPL", "D", probe(), ignore_invalid_symbol = true)
[c1, f1, s1, r1, a1, xo1, xu1] = request.security("NASDAQ:TSLA", "D", probe(), ignore_invalid_symbol = true)
[c2, f2, s2, r2, a2, xo2, xu2] = request.security("NASDAQ:NFLX", "D", probe(), ignore_invalid_symbol = true)
[c3, f3, s3, r3, a3, xo3, xu3] = request.security("NASDAQ:NVDA", "D", probe(), ignore_invalid_symbol = true)
[c4, f4, s4, r4, a4, xo4, xu4] = request.security("NASDAQ:AMZN", "D", probe(), ignore_invalid_symbol = true)
[c5, f5, s5, r5, a5, xo5, xu5] = request.security("NASDAQ:PLTR", "D", probe(), ignore_invalid_symbol = true)
[c6, f6, s6, r6, a6, xo6, xu6] = request.security("NASDAQ:META", "D", probe(), ignore_invalid_symbol = true)
[c7, f7, s7, r7, a7, xo7, xu7] = request.security("NASDAQ:GOOGL", "D", probe(), ignore_invalid_symbol = true)
[c8, f8, s8, r8, a8, xo8, xu8] = request.security("NASDAQ:AMD", "D", probe(), ignore_invalid_symbol = true)
[c9, f9, s9, r9, a9, xo9, xu9] = request.security("AMEX:GLD", "D", probe(), ignore_invalid_symbol = true)
[c10, f10, s10, r10, a10, xo10, xu10] = request.security("AMEX:VOO", "D", probe(), ignore_invalid_symbol = true)
[c11, f11, s11, r11, a11, xo11, xu11] = request.security("BITSTAMP:BTCUSD", "D", probe(), ignore_invalid_symbol = true)
[c12, f12, s12, r12, a12, xo12, xu12] = request.security("BITSTAMP:ETHUSD", "D", probe(), ignore_invalid_symbol = true)
[c13, f13, s13, r13, a13, xo13, xu13] = request.security("SPCFD:SPX", "D", probe(), ignore_invalid_symbol = true)
[c14, f14, s14, r14, a14, xo14, xu14] = request.security("TVC:NDQ", "D", probe(), ignore_invalid_symbol = true)
[c15, f15, s15, r15, a15, xo15, xu15] = request.security("TVC:DJI", "D", probe(), ignore_invalid_symbol = true)
[c16, f16, s16, r16, a16, xo16, xu16] = request.security("CBOE:VIX", "D", probe(), ignore_invalid_symbol = true)
[c17, f17, s17, r17, a17, xo17, xu17] = request.security("TVC:DXY", "D", probe(), ignore_invalid_symbol = true)
[c18, f18, s18, r18, a18, xo18, xu18] = request.security("TVC:USOIL", "D", probe(), ignore_invalid_symbol = true)
[c19, f19, s19, r19, a19, xo19, xu19] = request.security("TVC:GOLD", "D", probe(), ignore_invalid_symbol = true)
[c20, f20, s20, r20, a20, xo20, xu20] = request.security("TVC:SILVER", "D", probe(), ignore_invalid_symbol = true)
[c21, f21, s21, r21, a21, xo21, xu21] = request.security("FX:EURUSD", "D", probe(), ignore_invalid_symbol = true)
[c22, f22, s22, r22, a22, xo22, xu22] = request.security("FX:GBPUSD", "D", probe(), ignore_invalid_symbol = true)
[c23, f23, s23, r23, a23, xo23, xu23] = request.security("FX:USDJPY", "D", probe(), ignore_invalid_symbol = true)

var float[] entryPx = array.new_float(24, na)
var float[] qtyArr  = array.new_float(24, 0.0)
var float[] stopArr = array.new_float(24, na)

// One symbol: open it, close it, or leave it. Alerts on any transition.
step(i, sym, tradable, px, fastV, slowV, rsiV, atrV, xover, xunder) =>
    stopLv = array.get(stopArr, i)
    out    = ""

    if na(array.get(entryPx, i)) and xover and rsiV < rsiMax and atrV > 0
        rps = stopMult * atrV
        q   = rps > 0 ? math.floor(acctEq * riskPct / rps) : 0
        if q > 0
            array.set(entryPx, i, px)
            array.set(qtyArr,  i, q)
            array.set(stopArr, i, px - rps)
            alert((tradable ? "PAPER BUY " : "SIGNAL (untradable) ") + sym +
                  " | entry ~" + str.tostring(px, "#.####") +
                  " | STOP " + str.tostring(px - rps, "#.####") +
                  " | qty " + str.tostring(q, "#"),
                  alert.freq_once_per_bar_close)

    if not na(array.get(entryPx, i))
        ep  = array.get(entryPx, i)
        q   = array.get(qtyArr, i)
        pnl = (px - ep) * q
        pct = ep > 0 ? (px - ep) / ep * 100 : 0.0
        // Stop first: if the stop and the cross-down land on the same bar, the
        // stop is what would actually have filled.
        hitStop = not na(stopLv) and px <= stopLv
        if hitStop or xunder
            alert((pnl >= 0 ? "PROFIT" : "LOSS") + " " + sym + " CLOSED" +
                  " | " + money(pnl, pct) +
                  " | entry " + str.tostring(ep, "#.####") +
                  " -> exit " + str.tostring(px, "#.####") +
                  " | reason: " + (hitStop ? "STOP" : "SMA cross down"),
                  alert.freq_once_per_bar_close)
            array.set(entryPx, i, na)
            array.set(qtyArr,  i, 0.0)
            array.set(stopArr, i, na)
            out := "closed " + money(pnl, pct)
        else
            array.set(stopArr, i, math.max(nz(stopLv, px - stopMult * atrV),
                                           px - stopMult * atrV))
            out := "OPEN " + money(pnl, pct)
    else
        out := fastV > slowV ? (rsiV < rsiMax ? "armed" : "RSI blocked") : "flat"
    out

st0 = step(0, "AAPL", true, c0, f0, s0, r0, a0, xo0, xu0)
st1 = step(1, "TSLA", true, c1, f1, s1, r1, a1, xo1, xu1)
st2 = step(2, "NFLX", true, c2, f2, s2, r2, a2, xo2, xu2)
st3 = step(3, "NVDA", true, c3, f3, s3, r3, a3, xo3, xu3)
st4 = step(4, "AMZN", true, c4, f4, s4, r4, a4, xo4, xu4)
st5 = step(5, "PLTR", true, c5, f5, s5, r5, a5, xo5, xu5)
st6 = step(6, "META", true, c6, f6, s6, r6, a6, xo6, xu6)
st7 = step(7, "GOOGL", true, c7, f7, s7, r7, a7, xo7, xu7)
st8 = step(8, "AMD", true, c8, f8, s8, r8, a8, xo8, xu8)
st9 = step(9, "GLD", true, c9, f9, s9, r9, a9, xo9, xu9)
st10 = step(10, "VOO", true, c10, f10, s10, r10, a10, xo10, xu10)
st11 = step(11, "BTC", true, c11, f11, s11, r11, a11, xo11, xu11)
st12 = step(12, "ETH", true, c12, f12, s12, r12, a12, xo12, xu12)
st13 = step(13, "SPX", false, c13, f13, s13, r13, a13, xo13, xu13)
st14 = step(14, "NDQ", false, c14, f14, s14, r14, a14, xo14, xu14)
st15 = step(15, "DJI", false, c15, f15, s15, r15, a15, xo15, xu15)
st16 = step(16, "VIX", false, c16, f16, s16, r16, a16, xo16, xu16)
st17 = step(17, "DXY", false, c17, f17, s17, r17, a17, xo17, xu17)
st18 = step(18, "USOIL", false, c18, f18, s18, r18, a18, xo18, xu18)
st19 = step(19, "GOLD", false, c19, f19, s19, r19, a19, xo19, xu19)
st20 = step(20, "SILVR", false, c20, f20, s20, r20, a20, xo20, xu20)
st21 = step(21, "EURUSD", false, c21, f21, s21, r21, a21, xo21, xu21)
st22 = step(22, "GBPUSD", false, c22, f22, s22, r22, a22, xo22, xu22)
st23 = step(23, "USDJPY", false, c23, f23, s23, r23, a23, xo23, xu23)

var table t = table.new(position.top_right, 4, 25, border_width = 1)
paint(row, sym, tradable, px, txt) =>
    col = str.startswith(txt, "OPEN +") or str.startswith(txt, "closed +") ? color.lime :
          str.startswith(txt, "OPEN -") or str.startswith(txt, "closed -") ? color.red :
          txt == "armed" ? color.yellow : color.silver
    table.cell(t, 0, row, sym, text_color = tradable ? color.white : color.gray)
    table.cell(t, 1, row, tradable ? "Y" : "-",
         text_color = tradable ? color.teal : color.gray)
    table.cell(t, 2, row, str.tostring(px, "#.####"), text_color = color.silver)
    table.cell(t, 3, row, txt, text_color = col)

if barstate.islast
    table.cell(t, 0, 0, "SCANNER", bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(t, 1, 0, "TRADE",   bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(t, 2, 0, "last",    bgcolor = color.new(color.gray, 60), text_color = color.white)
    table.cell(t, 3, 0, "state / P&L", bgcolor = color.new(color.gray, 60), text_color = color.white)
    paint(1, "AAPL", true, c0, st0)
    paint(2, "TSLA", true, c1, st1)
    paint(3, "NFLX", true, c2, st2)
    paint(4, "NVDA", true, c3, st3)
    paint(5, "AMZN", true, c4, st4)
    paint(6, "PLTR", true, c5, st5)
    paint(7, "META", true, c6, st6)
    paint(8, "GOOGL", true, c7, st7)
    paint(9, "AMD", true, c8, st8)
    paint(10, "GLD", true, c9, st9)
    paint(11, "VOO", true, c10, st10)
    paint(12, "BTC", true, c11, st11)
    paint(13, "ETH", true, c12, st12)
    if showAll
        paint(14, "SPX", false, c13, st13)
    if showAll
        paint(15, "NDQ", false, c14, st14)
    if showAll
        paint(16, "DJI", false, c15, st15)
    if showAll
        paint(17, "VIX", false, c16, st16)
    if showAll
        paint(18, "DXY", false, c17, st17)
    if showAll
        paint(19, "USOIL", false, c18, st18)
    if showAll
        paint(20, "GOLD", false, c19, st19)
    if showAll
        paint(21, "SILVR", false, c20, st20)
    if showAll
        paint(22, "EURUSD", false, c21, st21)
    if showAll
        paint(23, "GBPUSD", false, c22, st22)
    if showAll
        paint(24, "USDJPY", false, c23, st23)
